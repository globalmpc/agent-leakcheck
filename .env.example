# Upstash Redis REST URL for the share server (Vercel Marketplace injects this).
KV_REST_API_URL=
# Upstash Redis REST token for the share server.
KV_REST_API_TOKEN=
# Alternative name for the REST URL; read when KV_REST_API_URL is unset.
UPSTASH_REDIS_REST_URL=
# Alternative name for the REST token; read when KV_REST_API_TOKEN is unset.
UPSTASH_REDIS_REST_TOKEN=
# Secret key (16+ chars, e.g. `openssl rand -hex 32`) for counting distinct sharers per day
# and for keying rate-limit hashes. Unset or shorter: distinct-sharer counting stays off
# and rate-limit keys are keyed with the Redis token.
STATS_SALT=
